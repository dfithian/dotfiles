	name = Dan Fithian
	email = daniel.m.fithian@gmail.com
[core]
	excludesfile = ~/.gitignore
	editor = /usr/bin/vim
[pager]
	branch = false
[pull]
	rebase = true
[credential]
	helper = store
	useHttpPath = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
